{% comment %}
  Before/after slider for one pair of photos already lined up on the same frame (tools/hatteras_align_photos.py).
  Usage: {% include hatteras/photo_slider.liquid before="/assets/.../a.jpg" after="/assets/.../b.jpg"
           before_label="6 May 2008" after_label="31 Aug 2011" before_alt="..." after_alt="..." ratio="857 / 464" %}
  Script: assets/hatteras/js/photo-slider.js (shared by every slider on the page).
{% endcomment %}
<div class="hat-photo-slider hat-compare-stage">
  <div class="hat-compare-photos" style="aspect-ratio: {{ include.ratio }}">
    <img class="before" src="{{ include.before | relative_url }}" alt="{{ include.before_alt }}" loading="lazy" decoding="async">
    <img class="after" src="{{ include.after | relative_url }}" alt="{{ include.after_alt }}" loading="lazy" decoding="async" style="clip-path: inset(0 0 0 50%)">
  </div>
  <span class="hat-compare-tag left">{{ include.before_label }}</span>
  <span class="hat-compare-tag right">{{ include.after_label }}</span>
  <div class="hat-compare-divider" style="left: 50%"><span></span></div>
  <input type="range" min="0" max="100" value="50" class="hat-compare-range" aria-label="Drag to compare {{ include.before_label }} with {{ include.after_label }}">
</div>
<script defer src="{{ '/assets/hatteras/js/photo-slider.js' | relative_url }}"></script>

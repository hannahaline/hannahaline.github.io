{% comment %}
  Shoreline change map: Leaflet map of every CoastSat transect coloured by its rate, a time series for the
  clicked transect, and a profile of the rates along the island. Data from tools/hatteras_shoreline_data.py.
  The page needs `map: true` and `chart: chartjs: true` in its front matter (the theme then loads Leaflet).
{% endcomment %}
<div class="hat-shoremap hat-bleed" id="shoremap" data-base="{{ '/assets/hatteras/data/' | relative_url }}">
  <div class="hat-shoremap-inner">
    <div class="hat-controls">
      <div class="hat-seg" role="group" aria-label="Period" id="shoremap-windows"></div>
      <div class="hat-seg" role="group" aria-label="Background map" id="shoremap-basemaps">
        <button type="button" data-base="aerial" class="on">Aerial photo</button>
        <button type="button" data-base="plain">Plain map</button>
      </div>
    </div>

    <div class="hat-shoremap-grid">
      <div id="shoremap-map" role="region" aria-label="Map of shoreline change rates along Hatteras Island"></div>
      <aside class="hat-shoremap-side">
        <div class="hat-legend" id="shoremap-legend" aria-label="Colour key"></div>
        <div class="hat-detail" id="shoremap-detail" aria-live="polite">
          <p class="hat-detail-prompt">Click any line on the map, or any dot on the chart below, to see how the shoreline at that spot has moved since the 1980s.</p>
        </div>
        <div class="hat-ts-wrap" hidden><canvas id="shoremap-ts" aria-label="Shoreline position through time at the selected spot"></canvas></div>
      </aside>
    </div>

    <div class="hat-profile">
      <h4 class="hat-profile-title">Along the island, south to north</h4>
      <div class="hat-profile-wrap"><canvas id="shoremap-profile" aria-label="Rate of shoreline change along the island"></canvas></div>
      <p class="hat-caption">
        Each dot is one survey line across the beach; they are 50 m apart. The black line is the trend smoothed over about 3.5 km.
        Gold bands mark beach nourishment projects. The satellite record ends in <span class="shoremap-end"></span>.
      </p>
    </div>
  </div>
</div>

<details class="hat-deeper hat-table-view">
<summary>View the rates as a table</summary>
<div class="hat-table-scroll"><table class="hat-table" id="shoremap-table"></table></div>
<p><a href="{{ '/assets/hatteras/data/shoreline_rates.json' | relative_url }}">Download the data (JSON)</a></p>
</details>

<script defer src="{{ '/assets/hatteras/js/shoreline-map.js' | relative_url }}"></script>

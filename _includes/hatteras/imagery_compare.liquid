{% comment %}
  Before/after aerial photo slider. Layers and spots: _data/hatteras_imagery.yml; photos saved by
  tools/hatteras_imagery_data.py into assets/hatteras/img/compare/. Script: assets/hatteras/js/imagery-compare.js.
{% endcomment %}
<div class="hat-compare hat-bleed" id="imgcompare" data-img="{{ '/assets/hatteras/img/compare/' | relative_url }}" data-index="{{ '/assets/hatteras/data/imagery_compare.json' | relative_url }}">
  <div class="hat-shoremap-inner">
    <div class="hat-controls">
      <div class="hat-seg" role="group" aria-label="Place" id="imgcompare-spots"></div>
    </div>
    <div class="hat-compare-years">
      <label>Left <select id="imgcompare-before"></select></label>
      <label>Right <select id="imgcompare-after"></select></label>
    </div>
    <div class="hat-compare-stage">
      <div class="hat-compare-photos" role="region" aria-label="Aerial photos compared side by side">
        <img id="imgcompare-before-img" alt="" decoding="async">
        <img id="imgcompare-after-img" alt="" decoding="async">
      </div>
      <span class="hat-compare-tag left" id="imgcompare-tag-before"></span>
      <span class="hat-compare-tag right" id="imgcompare-tag-after"></span>
      <div class="hat-compare-divider" id="imgcompare-divider"><span></span></div>
      <input type="range" min="0" max="100" value="50" class="hat-compare-range" id="imgcompare-range" aria-label="Drag to compare the two photos">
    </div>
    <p class="hat-caption" id="imgcompare-caption"></p>
    <p class="hat-caption hat-compare-credit" id="imgcompare-credit"></p>
  </div>
</div>

<script type="application/json" id="imgcompare-data">{{ site.data.hatteras_imagery | jsonify }}</script>
<script defer src="{{ '/assets/hatteras/js/imagery-compare.js' | relative_url }}"></script>

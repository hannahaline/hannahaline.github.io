{% comment %} Tabs across the Management pages: the introduction and one page per action, each also in the section menu {% endcomment %}
{% assign tabs = "/hatteras/management/|Introduction;/hatteras/management/dunes/|Dune building;/hatteras/management/nc-12/|NC-12;/hatteras/management/nourishment/|Beach nourishment;/hatteras/management/groins/|Groins" | split: ";" %}
<nav class="hat-tabs" aria-label="Management pages">
  {% for t in tabs %}
    {% assign parts = t | split: "|" %}
    {% if parts[0] == page.permalink %}
      <span class="hat-tab current" aria-current="page">{{ parts[1] }}</span>
    {% else %}
      <a class="hat-tab" href="{{ parts[0] | relative_url }}">{{ parts[1] }}</a>
    {% endif %}
  {% endfor %}
</nav>
